 <root BTCPP_format="4" >
     <BehaviorTree ID="BT_Holistic">
        <Sequence name="root_sequence">
            <!-- Move MiR to storage location-->
            <GoToMission name="go_to_storage" 
                        action_name="go_to_mission"
                        mission_id="5d4bcfbf-cc3a-11f0-b937-000e8e984489" /> 
            
            <!-- Home the Franka manipulator -->
            <GoHomeAction name="go_home"
                                   action_name="go_home"
                                   clear_planning_scene="true" />
            
            <!-- Calibrate camera using left side of cube -->
            <FrankaCalibrationAction name="cube_calibrate_left"
                                    action_name="cube_visual_calibration"
                                    side="left" />

            <!-- Home the Franka manipulator -->
            <GoHomeAction name="go_home"
                                   action_name="go_home"
                                   clear_planning_scene="false" />
            
             <!-- Pick up Container1 -->
            <PickUpAction name="pick_container1"
                         action_name="pick_up_container"
                         container_name="reagent_tray"
                         is_ot="false"/>

            <!-- Pick up Container1 -->
            <PickUpAction name="pick_container3"
                         action_name="pick_up_container"
                         container_name="cuvette_tray"
                         is_ot="false"/>

            
            <!-- Home the Franka manipulator -->
            <GoHomeAction name="go_home"
                                   action_name="go_home"
                                   clear_planning_scene="true" />

            <!-- Move MiR to storage location-->
            <GoToMission name="go_to_ot" 
                        action_name="go_to_mission"
                        mission_id="4898e76e-cc3a-11f0-b937-000e8e984489" /> 

            <!-- Calibrate camera using left side of cube -->
            <FrankaCalibrationAction name="cube_calibrate_left"
                                    action_name="cube_visual_calibration"
                                    side="left" />
            <!-- Home the Franka manipulator -->
            <GoHomeAction name="go_home"
                                   action_name="go_home"
                                   clear_planning_scene="false" />
            <!-- Place Container1 -->
            <PlaceAction name="place_container1"
                        action_name="place_container_OT"
                        container_name="cuvette_tray"
                        slot_name = "1"
                        />

            <PlaceAction name="place_container3"
                        action_name="place_container_OT"
                        container_name="reagent_tray"
                        slot_name = "2"
                        />

            <!-- Home the Franka manipulator -->
            <GoHomeAction name="go_home"
                                   action_name="go_home"
                                   clear_planning_scene="true" />
            
            <!-- Phase 2: Start OpenTrons2 protocol and go home in parallel -->
            <Parallel success_count="2" failure_count="1">
                <OpenTrons2RunProtocol name="run_sample_protocol"
                                     action_name="run_protocol"
                                     custom_labware_folder="/home/sdl/sdl_ws/src/ot2_control/ot2_control/custom_labware"
                                     protocol_path="/home/sdl/sdl_ws/src/ot2_control/ot2_control/protocols/full_protocol.py" 
                                     parameters_json='
                                      {
                                        "sample_count": 5,
                                        "v_f": 2000,
                                        "heating_time": 600,
                                        "large_tips_used": 0,
                                        "max_concentration": 0.3,
                                        "min_concentration": 0.025
                                      }
                                    '/> 
                <GoToMission name="go_to_home" 
                            action_name="go_to_mission"
                            mission_id="d7e12b66-cc39-11f0-b937-000e8e984489" />
            </Parallel>

            <!-- Move MiR to storage location-->
            <GoToMission name="go_to_ot" 
                        action_name="go_to_mission"
                        mission_id="4898e76e-cc3a-11f0-b937-000e8e984489" /> 

            <!-- Calibrate camera using left side of cube -->
            <FrankaCalibrationAction name="cube_calibrate_left"
                                    action_name="cube_visual_calibration"
                                    side="left" />
            <!-- Home the Franka manipulator -->
            <GoHomeAction name="go_home"
                                   action_name="go_home"
                                   clear_planning_scene="false" />

            <!-- Pick up Container1 -->
            <PickUpAction name="pick_container3"
                         action_name="pick_up_container"
                         container_name="cuvette_tray"
                         is_ot="true"/>

            <!-- Pick up Container1 -->
            <PickUpAction name="pick_container3"
                         action_name="pick_up_container"
                         container_name="reagent_tray"
                         is_ot="true"/>

            <!-- Home the Franka manipulator -->
            <GoHomeAction name="go_home"
                                   action_name="go_home"
                                   clear_planning_scene="true" />

            
            <GoToMission name="sample_handover" 
                        action_name="go_to_mission"
                        mission_id="21f5c79b-d200-11f0-badc-000e8e984489" />


            <!-- Calibrate camera using left side of cube -->
            <FrankaCalibrationAction name="cube_calibrate_left"
                                    action_name="cube_visual_calibration"
                                    side="left" />

            <!-- Home the Franka manipulator -->
            <GoHomeAction name="go_home"
                                   action_name="go_home"
                                   clear_planning_scene="false" />

            <PlaceAction name="place_container3"
                        action_name="place_container"
                        container_name="reagent_tray"
                        slot_name = ""
                        />
            
            <!-- Home the Franka manipulator -->
            <GoHomeAction name="go_home"
                                   action_name="go_home"
                                   clear_planning_scene="true" />

            <GoToMission name="go_to_storage" 
                        action_name="go_to_mission"
                        mission_id="5d4bcfbf-cc3a-11f0-b937-000e8e984489" /> 

            <!-- Calibrate camera using left side of cube -->
            <FrankaCalibrationAction name="cube_calibrate_left"
                                    action_name="cube_visual_calibration"
                                    side="true" />

            <!-- Home the Franka manipulator -->
            <GoHomeAction name="go_home"
                                   action_name="go_home"
                                   clear_planning_scene="false" />

            <PlaceAction name="place_container3"
                        action_name="place_container_OT"
                        container_name="reagent_tray"
                        slot_name = ""
                        />

            <!-- Home the Franka manipulator -->
            <GoHomeAction name="go_home"
                                   action_name="go_home"
                                   clear_planning_scene="true" />
            
            <!-- Move MiR to storage location-->
            <GoToMission name="go_to_home" 
                        action_name="go_to_mission"
                        mission_id="d7e12b66-cc39-11f0-b937-000e8e984489" /> 

        </Sequence>
     </BehaviorTree>
 </root>